# ============================================================================
# Borá Carregar — exemplo de configuração
#
# Copie para .env e preencha. O arquivo .env NUNCA vai para o repositório.
#   cp .env.example .env
#
# Nenhum valor real de produção pode ser commitado aqui (risco R-20).
# Os segredos abaixo são placeholders óbvios e devem ser trocados.
#   Gere segredos com:  openssl rand -hex 32
# ============================================================================

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Marca do produto (ADR-0007 — nome provisório, trocável sem mexer no código)
# ---------------------------------------------------------------------------
BORA_BRAND_NAME=Borá Carregar
BORA_BRAND_SHORT=Borá

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
POSTGRES_USER=bora
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=bora_carregar
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bora:TROQUE_ESTA_SENHA@localhost:5432/bora_carregar?schema=public

# Banco usado pelos testes de integração. Precisa ser DIFERENTE do de desenvolvimento:
# a suíte apaga os dados antes de rodar.
DATABASE_URL_TEST=postgresql://bora:TROQUE_ESTA_SENHA@localhost:5432/bora_carregar_test?schema=public

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
SWAGGER_ENABLED=true

# Origens permitidas no CORS, separadas por vírgula. Em produção, liste apenas
# os domínios do painel — nunca use "*".
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Autenticação
#
# GERE VALORES NOVOS. Estes são placeholders e a API se recusa a subir com eles
# quando NODE_ENV=production.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_gere_com_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_outro_valor_diferente_do_de_cima
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Senha do administrador global criado pelo seed. Só vale em desenvolvimento.
SEED_ADMIN_EMAIL=admin@sonare.com.br
SEED_ADMIN_PASSWORD=CHANGE_ME_senha_do_seed

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Limite mais apertado para o login, contra força bruta
RATE_LIMIT_AUTH_MAX=10

# ---------------------------------------------------------------------------
# Regras comerciais (ADR-0008 §9)
#
# Teto padrão de pré-autorização, em CENTAVOS. Nunca use ponto flutuante para
# dinheiro (ADR-0005). R$ 200,00 = 20000.
#
# Este é o último nível da hierarquia de resolução:
#   Charger → Site → Organization → esta variável
# ---------------------------------------------------------------------------
BORA_PREAUTH_CEILING_CENTS=20000

# Limiar de parada automática no cartão, em pontos percentuais do teto.
# 95 = para em 95% do teto. Ultrapassar o teto é prejuízo nosso (risco R-22).
BORA_AUTOSTOP_THRESHOLD_CARD_PCT=95

# Limiar no Pix. ~100 porque parar antes é prejuízo do motorista (ADR-0010 §3).
BORA_AUTOSTOP_THRESHOLD_PIX_PCT=100

# ---------------------------------------------------------------------------
# Pagamento
# ---------------------------------------------------------------------------
# Provedor usado para novos pagamentos.
#
#   mock    — simulado, para desenvolvimento e teste
#   manual  — o operador confirma no painel que recebeu por fora
#
# A API RECUSA SUBIR em produção com um provedor simulado como padrão: seria
# recarga de graça para todo mundo, com o sistema reportando "aprovado" em cada
# uma (ver PaymentProviderRegistry).
BORA_PAYMENT_PROVIDER=mock

# Regra 11.5, primeira metade: prazo para o carregador ACEITAR o comando de
# início. Estourado, a reserva é cancelada e nada é cobrado.
BORA_CHARGER_ACCEPT_TIMEOUT_SECONDS=120

# Regra 11.5, segunda metade: prazo para o veículo efetivamente começar a
# carregar depois do comando aceito. Maior porque o carro pode estar negociando
# com o carregador.
BORA_VEHICLE_START_TIMEOUT_SECONDS=300

# Intervalo do worker que expira sessões travadas e cobra o consumo das
# encerradas. Menor = cobrança mais rápida e mais consultas ao banco.
BORA_SETTLEMENT_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Maquininhas (FASE 8)
# ---------------------------------------------------------------------------
# Provedor usado pelos terminais de pagamento.
#
#   terminal-mock — maquininha simulada, para desenvolvimento e teste
#   manual        — o operador aprova no painel
#
# A MAQUININHA NUNCA INFORMA O PROVEDOR. Se informasse, um token de terminal
# furtado (risco R-32) escolheria um provedor simulado e teria recarga de graça,
# com o sistema registrando "pagamento aprovado". Quem decide é esta variável.
#
# A API recusa subir se o provedor não estiver registrado, se ele autorizar pelo
# backend em vez do terminal, ou — em produção — se for simulado.
BORA_TERMINAL_PAYMENT_PROVIDER=terminal-mock

# Validade do código de pareamento da maquininha, em minutos.
#
# Curta de propósito: o código é um portador — quem o tiver vira terminal daquele
# conector. O ciclo previsto (gerar no painel, digitar no equipamento) leva
# minutos, não horas.
BORA_TERMINAL_PAIRING_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# Adquirente real (FASE 7)
# ---------------------------------------------------------------------------
# Deixe vazio enquanto não houver credenciais: sem elas, o adapter nem é
# registrado, e o sistema opera com o provedor simulado.
#
# NUNCA versione credencial real. Estas linhas ficam no .env da máquina.
# BORA_PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
# BORA_PAGBANK_TOKEN=
# BORA_PAGBANK_WEBHOOK_SECRET=

# Só true depois de o adapter ter sido exercitado contra o sandbox E a suíte de
# conformidade ter passado. Enquanto for false, o adapter recusa toda operação
# e a API não sobe se ele for o provedor padrão.
# Ver docs/payments/fase-7-o-que-falta.md
BORA_PAGBANK_VERIFIED=false

# --- Rede (e.Rede) — fornecedor mais provável desde 2026-07-31 -------------
# PV e chave de integração vêm do card do projeto no Portal do Desenvolvedor
# Rede (sandbox) — menu "Meus Projetos". NUNCA versione credencial real.
#
# Deixe vazio enquanto não houver credenciais: sem elas, o adapter nem é
# registrado. Os endereços têm padrão (sandbox oficial) e só precisam ser
# preenchidos na virada para produção:
#   produção: BORA_REDE_BASE_URL=https://api.userede.com.br/erede
#             BORA_REDE_OAUTH_URL=https://api.userede.com.br/redelabs
# BORA_REDE_PV=
# BORA_REDE_INTEGRATION_KEY=
# BORA_REDE_BASE_URL=
# BORA_REDE_OAUTH_URL=
# BORA_REDE_WEBHOOK_TOKEN=

# Só true depois de a suíte de conformidade passar contra o sandbox real.
# O manual foi lido na íntegra (v1.38), mas manual lido ≠ sandbox exercitado.
# Ver docs/payments/rede-e-rede-contrato.md
BORA_REDE_VERIFIED=false

# ---------------------------------------------------------------------------
# Painel (Next.js)
# ---------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_BRAND_NAME=Borá Carregar

# ---------------------------------------------------------------------------
# OCPP — reservado para a FASE 2. Ainda não utilizado.
# ---------------------------------------------------------------------------
# OCPP_PATH=/ocpp
# OCPP_HEARTBEAT_INTERVAL_SECONDS=300
# OCPP_CALL_TIMEOUT_SECONDS=30
